{
  "name": "Fedora KDE Desktop with Sudo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "chmod +x /home/vscode/start-vnc.sh",
  "postStartCommand": "/home/vscode/start-vnc.sh",
  "postAttachCommand": "/home/vscode/start-vnc.sh"

}
